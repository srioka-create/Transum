<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulator Transit & Lelang Proyek Pemkot</title>
    <!-- Tailwind CSS untuk Styling Cepat & Modern -->
    <script src="https://jsdelivr.net"></script>
    <style>
        body { font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 p-4 md:p-8">

    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <header class="mb-8 border-b border-slate-200 pb-6 text-center md:text-left">
            <h1 class="text-3xl font-extrabold text-indigo-900">🚊 Simulator Transit & Lelang Proyek Pemkot 🚌</h1>
            <p class="text-slate-600 mt-2">Media pembelajaran interaktif perbandingan moda transportasi: <strong>Rail-based vs Road-based</strong>.</p>
        </header>

        <!-- Main Dashboard Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Column 1: Kontrol Parameter Skenario Kota -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <h2 class="text-xl font-bold text-slate-950 mb-4 border-b pb-2 flex items-center gap-2">🏙️ 1. Skenario Kota</h2>
                
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Panjang Koridor Proyek (km)</label>
                        <input type="number" id="distance" value="20" min="1" max="100" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" oninput="calculateTransit()">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Target Kapasitas (Penumpang/Jam)</label>
                        <input type="range" id="targetCap" min="5000" max="60000" step="5000" value="30000" class="w-full accent-indigo-600" oninput="updateCapLabel(this.value); calculateTransit();">
                        <div class="text-right text-sm font-bold text-indigo-700 mt-1" id="targetCapLabel">30.000 pax/jam</div>
                    </div>
                    <div class="bg-amber-50 border border-amber-200 p-4 rounded-xl text-sm text-amber-900">
                        <strong>Tugas Mahasiswa:</strong> Sesuaikan parameter di atas, lalu bandingkan performa finansial serta kapasitas Rail vs Road di sebelah kanan untuk menyusun materi <em>pitching</em> lelang!
                    </div>
                </div>
            </div>

            <!-- Column 2 & 3: Hasil Perbandingan Live -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <h2 class="text-xl font-bold text-slate-950 mb-4 border-b pb-2">📊 Hasil Analisis Tekno-Ekonomi</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Rail-Based Card -->
                        <div class="border border-indigo-100 bg-indigo-50/30 p-5 rounded-xl">
                            <div class="flex justify-between items-center mb-3">
                                <h3 class="text-lg font-bold text-indigo-950">🚊 Rail-Based (MRT/LRT)</h3>
                                <span id="railStatus" class="px-2 py-1 text-xs font-bold rounded"></span>
                            </div>
                            <ul class="space-y-3 text-sm">
                                <li class="flex justify-between"><span>Biaya Pengadaan (CAPEX):</span> <strong id="railCapex" class="text-slate-900"></strong></li>
                                <li class="flex justify-between"><span>Biaya Operasional (OPEX/thn):</span> <strong id="railOpex" class="text-slate-900"></strong></li>
                                <li class="flex justify-between"><span>Biaya Pemeliharaan/thn:</span> <strong id="railMaint" class="text-slate-900"></strong></li>
                                <li class="flex justify-between"><span>Alokasi Budget Marketing:</span> <strong id="railMkt" class="text-slate-900"></strong></li>
                                <li class="flex justify-between border-t pt-2 mt-2"><span>Maks. Kapasitas Sistem:</span> <strong id="railMaxCap" class="text-indigo-900"></strong></li>
                            </ul>
                        </div>

                        <!-- Road-Based Card -->
                        <div class="border border-emerald-100 bg-emerald-50/30 p-5 rounded-xl">
                            <div class="flex justify-between items-center mb-3">
                                <h3 class="text-lg font-bold text-emerald-950">🚌 Road-Based (BRT/Bus)</h3>
                                <span id="roadStatus" class="px-2 py-1 text-xs font-bold rounded"></span>
                            </div>
                            <ul class="space-y-3 text-sm">
                                <li class="flex justify-between"><span>Biaya Pengadaan (CAPEX):</span> <strong id="roadCapex" class="text-slate-900"></strong></li>
                                <li class="flex justify-between"><span>Biaya Operasional (OPEX/thn):</span> <strong id="roadOpex" class="text-slate-900"></strong></li>
                                <li class="flex justify-between"><span>Biaya Pemeliharaan/thn:</span> <strong id="roadMaint" class="text-slate-900"></strong></li>
                                <li class="flex justify-between"><span>Alokasi Budget Marketing:</span> <strong id="roadMkt" class="text-slate-900"></strong></li>
                                <li class="flex justify-between border-t pt-2 mt-2"><span>Maks. Kapasitas Sistem:</span> <strong id="roadMaxCap" class="text-emerald-900"></strong></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Juri / Scoring Section -->
                <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-md">
                    <h2 class="text-xl font-bold mb-4 border-b border-slate-700 pb-2 text-amber-400">⚖️ Panel Penilaian Dewan Kota (Juri)</h2>
                    <p class="text-sm text-slate-400 mb-4">Gunakan bagian ini untuk menghitung total skor tim mahasiswa berdasarkan performa presentasi lelang mereka.</p>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Nilai Rail -->
                        <div class="bg-slate-800 p-4 rounded-xl">
                            <h4 class="font-bold text-indigo-400 mb-2">Skor Tim Rail</h4>
                            <div class="space-y-2">
                                <label class="block text-xs">Kelayakan Finansial (1-50): <input type="number" id="scoreRailFin" min="0" max="50" value="35" class="bg-slate-700 text-white px-2 py-1 rounded w-16 float-right text-center" oninput="sumScores()"></label>
                                <label class="block text-xs clear-both">Argumentasi Operasional (1-30): <input type="number" id="scoreRailOps" min="0" max="30" value="25" class="bg-slate-700 text-white px-2 py-1 rounded w-16 float-right text-center" oninput="sumScores()"></label>
                                <label class="block text-xs clear-both">Strategi Marketing (1-20): <input type="number" id="scoreRailMkt" min="0" max="20" value="15" class="bg-slate-700 text-white px-2 py-1 rounded w-16 float-right text-center" oninput="sumScores()"></label>
                                <div class="text-right font-bold text-lg pt-2 text-indigo-300 border-t border-slate-700 mt-2">Total: <span id="totalRailScore">75</span></div>
                            </div>
                        </div>

                        <!-- Nilai Road -->
                        <div class="bg-slate-800 p-4 rounded-xl">
                            <h4 class="font-bold text-emerald-400 mb-2">Skor Tim Road</h4>
                            <div class="space-y-2">
                                <label class="block text-xs">Kelayakan Finansial (1-50): <input type="number" id="scoreRoadFin" min="0" max="50" value="45" class="bg-slate-700 text-white px-2 py-1 rounded w-16 float-right text-center" oninput="sumScores()"></label>
                                <label class="block text-xs clear-both">Argumentasi Operasional (1-30): <input type="number" id="scoreRoadOps" min="0" max="30" value="20" class="bg-slate-700 text-white px-2 py-1 rounded w-16 float-right text-center" oninput="sumScores()"></label>
                                <label class="block text-xs clear-both">Strategi Marketing (1-20): <input type="number" id="scoreRoadMkt" min="0" max="20" value="18" class="bg-slate-700 text-white px-2 py-1 rounded w-16 float-right text-center" oninput="sumScores()"></label>
                                <div class="text-right font-bold text-lg pt-2 text-emerald-300 border-t border-slate-700 mt-2">Total: <span id="totalRoadScore">83</span></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Logika Simulator JavaScript -->
    <script>
        function updateCapLabel(val) {
            document.getElementById('targetCapLabel').innerText = Number(val).toLocaleString('id-ID') + " pax/jam";
        }

        function formatTriliun(amount) {
            return "Rp " + amount.toFixed(2) + " Triliun";
        }

        function calculateTransit() {
            const distance = parseFloat(document.getElementById('distance').value) || 0;
            const targetCap = parseInt(document.getElementById('targetCap').value) || 0;

            // Konstanta Simulasi Perbandingan (Asumsi Rekayasa Transportasi makro)
